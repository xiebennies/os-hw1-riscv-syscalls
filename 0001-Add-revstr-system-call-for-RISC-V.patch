From 9adb42e3f16976a6f47e50e7f2bb60dbe7d86f8a Mon Sep 17 00:00:00 2001
From: xiebennies <xiebennies@users.noreply.github.com>
Date: Sun, 11 Oct 2026 14:59:46 +0000
Subject: [PATCH 1/2] Add revstr system call for RISC-V

---
 include/linux/syscalls.h          |  2 ++
 include/uapi/asm-generic/unistd.h |  5 +++-
 kernel/Makefile                   |  2 ++
 kernel/revstr.c                   | 43 +++++++++++++++++++++++++++++++
 4 files changed, 51 insertions(+), 1 deletion(-)
 create mode 100644 kernel/revstr.c

diff --git a/include/linux/syscalls.h b/include/linux/syscalls.h
index a34b0f9a9..b427bfca2 100644
--- a/include/linux/syscalls.h
+++ b/include/linux/syscalls.h
@@ -1385,4 +1385,6 @@ int __sys_getsockopt(int fd, int level, int optname, char __user *optval,
 		int __user *optlen);
 int __sys_setsockopt(int fd, int level, int optname, char __user *optval,
 		int optlen);
+asmlinkage long sys_revstr(char __user *str, size_t n);
+
 #endif
diff --git a/include/uapi/asm-generic/unistd.h b/include/uapi/asm-generic/unistd.h
index 45fa180cc..cd92d7ebd 100644
--- a/include/uapi/asm-generic/unistd.h
+++ b/include/uapi/asm-generic/unistd.h
@@ -886,8 +886,11 @@ __SYSCALL(__NR_futex_waitv, sys_futex_waitv)
 #define __NR_set_mempolicy_home_node 450
 __SYSCALL(__NR_set_mempolicy_home_node, sys_set_mempolicy_home_node)
 
+#define __NR_revstr 451
+__SYSCALL(__NR_revstr, sys_revstr)
+
 #undef __NR_syscalls
-#define __NR_syscalls 451
+#define __NR_syscalls 452
 
 /*
  * 32 bit systems traditionally used different
diff --git a/kernel/Makefile b/kernel/Makefile
index d754e0be1..31efa40a3 100644
--- a/kernel/Makefile
+++ b/kernel/Makefile
@@ -159,3 +159,5 @@ $(obj)/kheaders_data.tar.xz: FORCE
 	$(call cmd,genikh)
 
 clean-files := kheaders_data.tar.xz kheaders.md5
+
+obj-y += revstr.o
diff --git a/kernel/revstr.c b/kernel/revstr.c
new file mode 100644
index 000000000..fef400578
--- /dev/null
+++ b/kernel/revstr.c
@@ -0,0 +1,43 @@
+#include <linux/syscalls.h>
+#include <linux/slab.h>
+#include <linux/errno.h>
+#include <linux/uaccess.h>
+#include <linux/printk.h>
+
+SYSCALL_DEFINE2(revstr, char __user *, str, size_t, n)
+{
+	char *buf;
+	size_t i;
+	char tmp;
+
+	if (n == (size_t)-1)
+		return -EINVAL;
+
+	buf = kmalloc(n + 1, GFP_KERNEL);
+	if (buf == NULL)
+		return -ENOMEM;
+
+	if (copy_from_user(buf, str, n) != 0) {
+		kfree(buf);
+		return -EFAULT;
+	}
+
+	buf[n] = '\0';
+	pr_info("The origin string: %s\n", buf);
+
+	for (i = 0; i < n / 2; i++) {
+		tmp = buf[i];
+		buf[i] = buf[n - 1 - i];
+		buf[n - 1 - i] = tmp;
+	}
+
+	pr_info("The reversed string: %s\n", buf);
+
+	if (copy_to_user(str, buf, n) != 0) {
+		kfree(buf);
+		return -EFAULT;
+	}
+
+	kfree(buf);
+	return 0;
+}
